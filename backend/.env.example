# Copy this file to .env and enter your local MySQL credentials (running the API outside Docker).
DATABASE_URL=mysql+pymysql://root:YOUR_MYSQL_PASSWORD@127.0.0.1:3306/cloudsched
HOST_TOTAL_CPU=8
HOST_TOTAL_RAM_MB=16384
HOST_TOTAL_STORAGE_MB=102400

# simulate = no Docker needed | docker = real containers (needs `pip install docker` and a reachable Docker daemon)
EXECUTOR_MODE=simulate
TIME_SCALE=1
DOCKER_IMAGE=python:3.12-alpine
AUTOMATION_ENABLED=false
AUTOMATION_INTERVAL=2
AUTOMATION_POLICY=PRIORITY_AGING
AGING_SECONDS=60
